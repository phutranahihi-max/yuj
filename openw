  function getUnitAtTile(tile) {
    if (tile === null || tile === undefined) return null;
    const state = typeof getGameState === "function" ? getGameState() : null;
    if (!state) return null;
    const game = state.game;
    const myPlayer = state.myPlayer;
    if (!game) return null;

    const getTileOfUnit = (u) => {
      if (!u) return null;
      try {
        if (typeof u.tile === "function") return u.tile();
        if (u.tile !== undefined) return u.tile;
        if (u.state && u.state.tile !== undefined) return u.state.tile;
      } catch (_) {}
      return null;
    };

    if (myPlayer && typeof myPlayer.units === "function") {
      try {
        const units = myPlayer.units();
        for (const u of units) {
          if (!u) continue;
          const ut = getTileOfUnit(u);
          if (ut === tile || (typeof ut === "number" && typeof tile === "number" && Math.abs(ut - tile) <= 1)) {
            return u;
          }
        }
      } catch (_) {}
    }

    if (typeof game.units === "function") {
      try {
        const units = game.units();
        for (const u of units) {
          if (!u) continue;
          const ut = getTileOfUnit(u);
          if (ut === tile || (typeof ut === "number" && typeof tile === "number" && Math.abs(ut - tile) <= 1)) {
            return u;
          }
        }
      } catch (_) {}
    }

    if (typeof game.unitStates === "function" && typeof game.unit === "function") {
      try {
        for (const uState of game.unitStates().values()) {
          if (uState && (uState.tile === tile || (typeof uState.tile === "number" && typeof tile === "number" && Math.abs(uState.tile - tile) <= 1))) {
            const u = game.unit(uState.id);
            if (u) return u;
          }
        }
      } catch (_) {}
    }

    return null;
  }

