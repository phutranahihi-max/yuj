  function setupSettingHotkeys() {
    const checkboxes = ui.querySelectorAll('input[type="checkbox"]');
    checkboxes.forEach((cb) => {
      if (!cb.id) return;
      const label = cb.closest("label");
      if (label) {
        if (label.querySelector(".blon-setting-hotkey")) return;
        const span = document.createElement("span");
        span.className = "blon-setting-hotkey";
        span.dataset.settingId = cb.id;
        span.style.cssText = "cursor:pointer;margin-left:6px;font-size:10px;font-family:monospace;font-weight:bold;user-select:none;display:inline-block;";
        span.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (activeRebindSettingId === cb.id) {
            activeRebindSettingId = null;
          } else {
            activeRebindSettingId = cb.id;
            internalRebindSlot = null;
            internalRebindAction = null;
          }
          refreshSettingHotkeyLabels();
          buildBindMatrix();
          buildActionBindMatrix();
        });
        label.appendChild(span);
