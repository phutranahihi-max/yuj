        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.globalAlpha = 0.8;
        ctx.stroke();

        const blastPx = pxRadius(transform, tgt.wx, tgt.wy, radius);
        ctx.beginPath();
        ctx.arc(sc.x, sc.y, blastPx, 0, Math.PI * 2);
        ctx.fillStyle = color.replace(")", ",0.06)").replace("rgb(", "rgba(") || "rgba(255,153,0,0.06)";
        ctx.globalAlpha = 1;
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = 1;
        ctx.globalAlpha = 0.35;
        ctx.stroke();
        ctx.globalAlpha = 1;

        ctx.font = "bold 10px monospace";
        ctx.fillStyle = color;
        ctx.globalAlpha = 0.95;
        ctx.textAlign = "center";
        ctx.textBaseline = "bottom";
        ctx.fillText(`#${i + 1} ${label}`, sc.x, sc.y - 11);
        ctx.globalAlpha = 1;
      }
    }

    function arm() {
      if (!cfg.preNukeEnabled) return;
      armed = true;
      autoFired = false;
      ensureCanvas();
      if (!ddRafId) ddRafId = requestAnimationFrame(renderDD);
      updatePNTooltip();
    }

    function disarm() {
      armed = false;
      targets.length = 0;
      updatePNTooltip();
    }

    function clearTargets() {
      targets.length = 0;
      updatePNTooltip();
    }

    function fireSalvo() {
      if (firing) return;
      if (targets.length === 0) return;
      firing = true;
      armed = false;
      const snap = [...targets];
      targets.length = 0;
      updatePNTooltip();
      let idx = 0;
      function launchNext() {
        if (idx >= snap.length) {
          firing = false;
          updatePNTooltip();
          return;
        }
        const tgt = snap[idx++];
        sendPacket({ type: "build_unit", unit: tgt.unit, tile: tgt.tile });
        setTimeout(launchNext, 120);
      }
      launchNext();
    }

    function onDocClick(e) {
      if (!armed) return;
      if (e.target && e.target.closest && (
        e.target.closest("#blon-root") ||
        e.target.closest("leader-board")
      )) return;
      try {
        const game = (() => {
          let g = null;
          try { g = readCachedGameView(); } catch (_) {}
          if (!g) {
            try {
              const ov = querySelectorAcrossDocs("player-info-overlay");
              g = ov && ov.game ? ov.game : null;
            } catch (_) {}
          }
          return g;
        })();
        const transform = getGameTransform();
        if (!game || !transform) return;
        const wc = transform.screenToWorldCoordinates(e.clientX, e.clientY);
        if (!wc || typeof game.isValidCoord !== "function" || !game.isValidCoord(wc.x, wc.y)) return;
        const tile = game.ref(wc.x, wc.y);
        if (tile === null || tile === undefined) return;
        let isUndoMouse = false;
        if (cfg.preNukeUndoKey === "left click" && e.button === 0) isUndoMouse = true;
        else if (cfg.preNukeUndoKey === "middle click" && e.button === 1) isUndoMouse = true;
        else if (cfg.preNukeUndoKey === "right click" && e.button === 2) isUndoMouse = true;

        if (isUndoMouse) {
          if (targets.length > 0) targets.pop();
          updatePNTooltip();
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const unit = getSelectedNukeType() || "Atom Bomb";
        targets.push({ tile, wx: wc.x, wy: wc.y, unit });
        updatePNTooltip();
        e.stopPropagation();
      } catch (_) {}
    }

    function onDocContextMenu(e) {
      if (!armed) return;
      e.preventDefault();
    }

    function matchKey(e, cfgKey) {
      const k = (cfgKey || "").toLowerCase();
      if (!k) return false;

      if (k.length === 1) return e.key.toLowerCase() === k;

      return e.key.toLowerCase() === k;
    }

    function onKeyDown(e) {
      if (!cfg.preNukeEnabled) return;
      if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA" || e.target.isContentEditable)) return;
      if (matchKey(e, cfg.preNukeArmKey)) {
        e.preventDefault();
        if (armed) disarm(); else arm();
      } else if (matchKey(e, cfg.preNukeFireKey)) {
        e.preventDefault();
        fireSalvo();
      } else if (matchKey(e, cfg.preNukeUndoKey)) {
        e.preventDefault();
        if (targets.length > 0) targets.pop();
        updatePNTooltip();
      } else if (e.key === "Escape" && armed) {
        disarm();
      }
    }

    window.addEventListener("keydown", onKeyDown, true);
    window.addEventListener("mousedown", onDocClick, true);
    window.addEventListener("contextmenu", onDocContextMenu, true);

    function autoFireTick() {
      if (!cfg.preNukeAutoFire || autoFired || firing) return;
      try {
        const state = getGameState();
        if (!state || !state.myPlayer || !state.game) return;
        const myTiles = getMyTileCount(state.game, state.myPlayer);
        if (myTiles === null) return;
        if (lastMyTileCount === null) { lastMyTileCount = myTiles; return; }
        const lost = lastMyTileCount - myTiles;
        lastMyTileCount = myTiles;
        if (lost > 0) {
          autoFired = true;
          fireSalvo();
        }
      } catch (_) {}
    }

    setInterval(autoFireTick, 500);

    setInterval(updatePNTooltip, 1500);

    window.__blonPreNuke = {
      arm,
      disarm,
      fire: fireSalvo,
      clearTargets,
      targets,
      get armed() { return armed; },
      enableAutoFire() { autoFired = false; lastMyTileCount = null; updatePNTooltip(); },
      disableAutoFire() { autoFired = false; lastMyTileCount = null; updatePNTooltip(); },
      resetAutoFired() { autoFired = false; lastMyTileCount = null; }
    };

  })();

  (function blonFortressRangeOverlay() {
    let fortressCanvas = null;
    let fortressCtx = null;
    let animFrameId = null;
    let renderFrameCount = 0;

    const TYPE_DEFAULT_RADIUS = {
      "Defense Post": 25,
      "SAM Launcher": 75,
      "Missile Silo": 150,
      "City": 20,
      "Factory": 20,
      "Port": 20
    };
    const RADIUS_PATTERNS = [
      "defensePostRange", "fortressRange", "defenseRange",
      "postRange", "towerRange", "attackRange", "range"
    ];

    function ensureCanvas() {
      if (fortressCanvas && fortressCanvas.isConnected) return;
      fortressCanvas = document.createElement("canvas");
      fortressCanvas.id = "blon-fortress-range-canvas";
      fortressCanvas.style.cssText = "position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:999996;";
      (document.body || document.documentElement).appendChild(fortressCanvas);
      fortressCtx = fortressCanvas.getContext("2d");
      resizeCanvas();
      window.addEventListener("resize", resizeCanvas);
    }

    function resizeCanvas() {
      if (!fortressCanvas) return;
      fortressCanvas.width = window.innerWidth;
      fortressCanvas.height = window.innerHeight;
    }

    function getOverlay() {
      try {
        const game = readCachedGameView();
        const transform = readCachedTransform ? readCachedTransform() : (typeof getGameTransform === "function" ? getGameTransform() : null);
        if (game && transform) {
          return { game, transform };
        }
      } catch (e) {}
      return null;
    }

    function w2s(transform, wx, wy) {
      try {
        return transform.worldToScreenCoordinates({ x: wx, y: wy });
      } catch (e) {
        return null;
      }
    }

    function radiusPx(transform, wx, wy, r) {
      try {
        const p1 = transform.worldToScreenCoordinates({ x: wx, y: wy });
        const p2 = transform.worldToScreenCoordinates({ x: wx + r, y: wy });
        return Math.abs(p2.x - p1.x);
      } catch (e) {
        return r * (transform?.scale || 1);
      }
    }

    function getUnitWorld(game, unit) {
      let tile = null;
      try { tile = typeof unit.tile === "function" ? unit.tile() : unit.tile; } catch (e) {}
      if (tile == null && unit.state) tile = unit.state.tile;
      if (tile == null) return null;
      let x = null, y = null;
      try { if (typeof game.x === "function") x = game.x(tile); } catch (e) {}
      try { if (typeof game.y === "function") y = game.y(tile); } catch (e) {}
      if (x == null && typeof tile === "object" && tile !== null) { x = tile.x; y = tile.y; }
      if (x == null) x = unit.x != null ? unit.x : (unit.state ? unit.state.x : null);
      if (y == null) y = unit.y != null ? unit.y : (unit.state ? unit.state.y : null);
      if (x == null || y == null || isNaN(x) || isNaN(y)) return null;
      return { x, y };
    }

    function getUnits(game, type) {
      const out = [];
      const seen = new Set();
      const push = (u) => {
        if (!u) return;
        let id = null;
        try { id = typeof u.id === "function" ? u.id() : u.id; } catch (e) {}
        if (id != null) {
          if (seen.has(id)) return;
          seen.add(id);
        }
        out.push(u);
      };
      try {
        if (typeof game.units === "function") {
          const us = game.units(type) || [];
          for (let i = 0; i < us.length; i++) push(us[i]);
        }
      } catch (e) {}
      try {
        if (typeof game.unitStates === "function" && typeof game.unit === "function") {
          for (const st of game.unitStates().values()) {
            if (st && st.unitType === type) {
              const u = game.unit(st.id);
              if (u) push(u);
            }
          }
        }
      } catch (e) {}
      return out;
    }

    function filterOwner(owner, myPlayer, filterMode) {
      if (filterMode === "all") return true;
      if (!myPlayer) return true;
      const isSelf = owner && samePlayer(owner, myPlayer);
      const isAlly = owner && isFriendlyPlayer(myPlayer, owner);
      if (filterMode === "own") return isSelf || isAlly;
      if (filterMode === "enemies") return !!owner && !isSelf && !isAlly;
      return true;
    }

    function resolveRadius(game, type, unit) {
      if (cfg.fortressRangeAutoRadius === false && cfg.fortressRangeManualRadius) {
        return cfg.fortressRangeManualRadius;
      }
      let level = 1;
      try {
        level = typeof unit.level === "function" ? unit.level() : (unit.level || (unit.state?.level) || 1);
      } catch (e) {}
      try {
        const cfgObj = typeof game.config === "function" ? game.config() : null;
        if (cfgObj) {
          for (let i = 0; i < RADIUS_PATTERNS.length; i++) {
            const name = RADIUS_PATTERNS[i];
            const fn = cfgObj[name];
            if (typeof fn === "function") {
              const v = fn(level);
              if (typeof v === "number" && v > 0) return v;
            } else if (typeof fn === "number" && fn > 0) {
              return fn;
            }
          }
        }
      } catch (e) {}
      try {
        const info = typeof game.unitInfo === "function" ? game.unitInfo(type) : null;
        if (info) {
          if (typeof info.range === "number" && info.range > 0) return info.range;
          if (typeof info.range === "function") {
            const v = info.range(level);
            if (typeof v === "number" && v > 0) return v;
          }
        }
      } catch (e) {}
      return TYPE_DEFAULT_RADIUS[type] || 25;
    }

    function drawCircle(ctx, sx, sy, rp, labelText) {
      if (!ctx || rp <= 0) return;
      const strokeColor = "rgba(255, 64, 64, 0.9)";
      const fillColor = "rgba(255, 64, 64, 0.12)";

      ctx.beginPath();
      ctx.arc(sx, sy, rp, 0, Math.PI * 2);
      ctx.strokeStyle = strokeColor;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = fillColor;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(sx, sy, 3, 0, Math.PI * 2);
      ctx.fillStyle = strokeColor;
      ctx.fill();

      if (labelText && cfg.fortressRangeShowLabel !== false) {
        ctx.font = "bold 10px monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        const tw = ctx.measureText(labelText).width;
        const ly = sy - rp - 10;
        ctx.fillStyle = "rgba(0, 0, 0, 0.75)";
        ctx.beginPath();
        if (typeof ctx.roundRect === "function") {
          ctx.roundRect(sx - (tw + 10) / 2, ly - 7, tw + 10, 14, 3);
        } else {
          ctx.rect(sx - (tw + 10) / 2, ly - 7, tw + 10, 14);
        }
        ctx.fill();
        ctx.strokeStyle = "rgba(255, 64, 64, 0.6)";
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.fillStyle = strokeColor;
        ctx.fillText(labelText, sx, ly);
      }
    }

    function renderFortressOverlay() {
      animFrameId = requestAnimationFrame(renderFortressOverlay);
      if ((cfg.features?.tabHiddenPause !== false && document.hidden) || (cfg.features && cfg.features.overlays === false) || !cfg.features?.fortressRange) {
        if (fortressCtx && fortressCanvas) fortressCtx.clearRect(0, 0, fortressCanvas.width, fortressCanvas.height);
        return;
      }
      if (cfg.features?.lowLagMode || cfg.features?.highFpsOverlays === false) {
        renderFrameCount++;
        const step = cfg.features?.highFpsOverlays === false ? 2 : 3;
        if (renderFrameCount % step !== 0) return;
      }
      const overlay = getOverlay();
      if (!overlay || !fortressCtx || !fortressCanvas) return;
      const { game, transform } = overlay;
      const ctx = fortressCtx;
      ctx.clearRect(0, 0, fortressCanvas.width, fortressCanvas.height);

      let myPlayer = null;
      try { myPlayer = game.myPlayer ? game.myPlayer() : null; } catch (e) {}

      const activeTypes = Array.isArray(cfg.fortressRangeTypes) && cfg.fortressRangeTypes.length > 0
        ? cfg.fortressRangeTypes
        : ["Defense Post"];
      const filterMode = cfg.fortressRangeFilter || "own";
      const showBuilding = !!cfg.fortressRangeShowBuilding;

      for (let tIdx = 0; tIdx < activeTypes.length; tIdx++) {
        const type = activeTypes[tIdx];
        const units = getUnits(game, type);
        for (let uIdx = 0; uIdx < units.length; uIdx++) {
          const u = units[uIdx];
          try {
            if (typeof u.isActive === "function" && !u.isActive()) continue;
            const isBuilding = typeof u.isUnderConstruction === "function" && u.isUnderConstruction();
            if (isBuilding && !showBuilding) continue;
            const owner = safeOwner(u, game);
            if (!filterOwner(owner, myPlayer, filterMode)) continue;
            const world = getUnitWorld(game, u);
            if (!world) continue;
            const sc = w2s(transform, world.x, world.y);
            if (!sc || !Number.isFinite(sc.x) || !Number.isFinite(sc.y)) continue;
            const margin = 100;
            if (sc.x + margin < 0 || sc.x - margin > fortressCanvas.width ||
                sc.y + margin < 0 || sc.y - margin > fortressCanvas.height) continue;
            const r = resolveRadius(game, type, u);
            const rp = radiusPx(transform, world.x, world.y, r);
            drawCircle(ctx, sc.x, sc.y, rp, type);
          } catch (e) {}
        }
      }

      if (Array.isArray(cfg.fortressRangeManualMarks)) {
        for (let mIdx = 0; mIdx < cfg.fortressRangeManualMarks.length; mIdx++) {
          const mk = cfg.fortressRangeManualMarks[mIdx];
          if (!mk || !Number.isFinite(mk.x) || !Number.isFinite(mk.y)) continue;
          const sc = w2s(transform, mk.x, mk.y);
          if (!sc || !Number.isFinite(sc.x) || !Number.isFinite(sc.y)) continue;
          const r = mk.r || cfg.fortressRangeManualRadius || 25;
          const rp = radiusPx(transform, mk.x, mk.y, r);
          drawCircle(ctx, sc.x, sc.y, rp, `Manual #${mIdx + 1}`);
        }
      }
    }

    function onDocClick(e) {
      if (!cfg.features?.fortressRange || !cfg.fortressRangeManualMode) return;
      if (e.button !== 0) return;
      if (e.target && e.target.closest && (
        e.target.closest("#blon-root") ||
        e.target.closest("leader-board") ||
        e.target.closest(".blon-popout-panel") ||
        e.target.closest("input, select, textarea, button")
      )) return;
      try {
        const overlay = getOverlay();
        if (!overlay || !overlay.transform) return;
        const transform = overlay.transform;
        if (typeof transform.screenToWorldCoordinates !== "function") return;
        const wc = transform.screenToWorldCoordinates(e.clientX, e.clientY);
        if (!wc || isNaN(wc.x) || isNaN(wc.y)) return;
        const r = (cfg.fortressRangeAutoRadius === false && cfg.fortressRangeManualRadius) ? cfg.fortressRangeManualRadius : 25;
        if (!Array.isArray(cfg.fortressRangeManualMarks)) cfg.fortressRangeManualMarks = [];
        cfg.fortressRangeManualMarks.push({ x: wc.x, y: wc.y, r });
        saveCfg();
        const countEl = document.getElementById("blon-fortress-marks-count");
        if (countEl) countEl.textContent = cfg.fortressRangeManualMarks.length;
      } catch (err) {}
    }

    function startFortressOverlay() {
      ensureCanvas();
      window.addEventListener("click", onDocClick, true);
      if (!animFrameId) animFrameId = requestAnimationFrame(renderFortressOverlay);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startFortressOverlay);
    } else {
      startFortressOverlay();
    }
  })();

})();
