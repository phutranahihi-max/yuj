  function refreshSettingHotkeyLabels() {
    if (!ui) return;
    const spans = ui.querySelectorAll(".blon-setting-hotkey");
    spans.forEach((span) => {
      const cbId = span.dataset.settingId;
      if (activeRebindSettingId === cbId) {
        span.textContent = "[PRESS KEY]";
        span.style.color = "#ffaa00";
      } else {
        cfg.settingHotkeyMap = cfg.settingHotkeyMap || {};
        const boundKey = cfg.settingHotkeyMap[cbId];
        if (boundKey) {
          span.textContent = `[${boundKey.toUpperCase()}]`;
          span.style.color = "var(--blon-gui-color)";
        } else {
          span.textContent = "[NONE]";
