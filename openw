    function attachPreNukeKeyCapture(input, cfgProp) {
      if (!input) return;
      input.addEventListener("focus", () => { input.value = "Press key/click…"; input.style.color = "#fff"; });
      input.addEventListener("keydown", (e) => {
        e.preventDefault();
        e.stopPropagation();
        let k = e.key;
        if (k === "Escape") { input.value = formatVal(cfg[cfgProp]); input.style.color = "#ffcc00"; input.blur(); return; }
        if (k === " ") k = "Space";
        cfg[cfgProp] = k.toLowerCase();
        input.value = formatVal(cfg[cfgProp]);
        input.style.color = "#ffcc00";
        saveCfg();
        input.blur();
      });
      input.addEventListener("mousedown", (e) => {
        if (document.activeElement !== input) return;
        e.preventDefault();
        e.stopPropagation();
        let btn = "";
        if (e.button === 0) btn = "left click";
        else if (e.button === 1) btn = "middle click";
        else if (e.button === 2) btn = "right click";
        if (btn) {
          cfg[cfgProp] = btn;
          input.value = formatVal(btn);
          input.style.color = "#ffcc00";
          saveCfg();
          input.blur();
        }
      });
      input.addEventListener("contextmenu", (e) => {
        if (document.activeElement === input) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
      function formatVal(v) {
        if (!v) return "";
        if (v.indexOf("click") !== -1) {
          return v.split(" ").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
        }
        return v.length === 1 ? v.toUpperCase() : v;
      }
      input.addEventListener("blur", () => { input.value = formatVal(cfg[cfgProp]); input.style.color = "#ffcc00"; });
    }
